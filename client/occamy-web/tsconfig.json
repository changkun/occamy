{
  // The protocol v1 client core (src/protocol) alone, with the browser's
  // types and no others, so that the library cannot use Node's or the
  // shell's by accident. tsconfig.app.json checks the React shell around
  // it, and tsconfig.test.json the tests, which run in Node.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/protocol/**/*.ts"],
  "exclude": ["src/protocol/**/*.test.ts", "src/protocol/testing/**", "src/protocol/demo/vite.config.ts"]
}
