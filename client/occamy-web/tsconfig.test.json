{
  // Everything lint reads with type information: the shell, the core,
  // their tests, which run in Node under vitest, and the configs that
  // build and run them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"],
  "exclude": []
}
