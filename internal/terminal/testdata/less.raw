// Dial connects to guacd at addr and performs the handshake.[m
[7mfunc[27m Dial(ctx context.Context, addr string, c Config) (*Conn, error) {[m
        var d net.Dialer[m
        nc, err := d.DialContext(ctx, "tcp", addr)[m
        if err != nil {[m
                return nil, fmt.Errorf("guacd: %w", err)[m
        }[m
        conn, err := Handshake(ctx, nc, c)[m
        if err != nil {[m
                nc.Close()[m
                return nil, err[m
        }[m
        return conn, nil[m
}[m
[m
// Handshake performs the Guacamole handshake on nc. It returns once guacd[m
:[K[K/[K// has sent ready, which happens before guacd connects to the remote desktop,[m
